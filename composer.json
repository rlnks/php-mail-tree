    "type": "library",
    "license": "MIT",
    "keywords": [
        "email",
        "html",
        "mail",
        "builder",
        "template",
        "responsive",
        "newsletter",
        "email-builder",
        "html-email",
        "transactional-email"
    ],
    "homepage": "https://github.com/rlnks/php-mail-tree",
    "support": {
        "issues": "https://github.com/rlnks/php-mail-tree/issues",
        "source": "https://github.com/rlnks/php-mail-tree"
    },
    "authors": [
        {
            "name": "RLNKS",
            "homepage": "https://rlnks.com"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "autoload": {
        "psr-4": {
            "Rlnks\\MailTree\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "minimum-stability": "stable"
}
